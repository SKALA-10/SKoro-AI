FROM python:3.11-slim

WORKDIR /app

# 필수 패키지 설치 및 apt 캐시 정리
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# pip 업그레이드
RUN python3 -m pip install --upgrade pip

# torch CPU 전용 버전 설치 (nvidia-* 없이)
RUN pip install --no-cache-dir torch==2.2.2+cpu torchvision==0.17.2+cpu \
    -f https://download.pytorch.org/whl/torch_stable.html

# transformers 설치
RUN pip install --no-cache-dir transformers==4.44.2

# sentence-transformers 본체만 설치 (중복 방지)
RUN pip install --no-cache-dir sentence-transformers==3.0.1 --no-deps

# 나머지 requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
